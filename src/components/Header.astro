---
import NavButton from "./NavButton.astro";
---

<header class="header">
    <div class="container">
        <a aria-label="Home" href="/" class="logo">
            <tidal-orb reach="8"></tidal-orb>
            <span>SV</span>
        </a>
        <nav class="nav">
            <!-- <NavButton label="blog" variant="secondary" /> -->
        </nav>
    </div>
</header>

<script>
    import "./tidal-orb.ts";
</script>

<style>
    .header {
        width: 100%;
        margin: auto;
        align-items: center;
        border-bottom: 1px solid var(--color-text);
    }

    .container {
        padding: 0.5rem var(--page-margin);
        margin: auto;
        max-width: var(--md);
        display: flex;
        align-self: center;
        justify-content: space-between;
    }

    .logo {
        position: relative;
        font-family: var(--font-header);
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
    }

    /* A small orb behind the S and a sliver of the V. */
    .logo tidal-orb {
        position: absolute;
        width: 1.45rem;
        left: -0.3rem;
        top: 50%;
        translate: 0 -50%;
        --orb-shadow-x: -2px;
        --orb-shadow-y: 1.5px;
    }

    .logo span {
        position: relative;
    }
</style>
