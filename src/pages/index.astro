---
import Page from "../layouts/BaseLayout.astro";
const pageTitle = "Sagar Velagala";
---

<Page pageTitle={pageTitle}>
    <main>
        <section class="hero">
            <tidal-orb></tidal-orb>
            <p class="pre-title">Hi! My name's</p>
            <h1>Sagar Velagala.</h1>
            <p class="intro">
                <strong
                    >I'm a software engineer specializing in data and analytics.</strong
                > I've been an analyst, marketer, and engineer. I've worked in CPG,
                B2B SaaS, and entertainment. I've been the tenth employee, and the
                ten-thousandth. Today — I'm building data models, pipelines, and
                custom data viz apps at Netflix. Outside of work, I find myself
                learning... for fun! I'm usually reading, tinkering, or making time
                for some new project or hobby.
            </p>
        </section>
        <p>
            I get a kick out of variety and prefer the full quote,

            <q
                >A jack of all trades is a master of none, <strong
                    >but oftentimes better than a master of one</strong
                >.</q
            >

            If you'd like to get in touch, find me on: <a
                href="https://www.linkedin.com/in/sagarvelagala/"
                target="_blank"
                rel="noopener noreferrer">LinkedIn</a
            >,
            <a
                href="https://www.github.com/sagarvxyz"
                target="_blank"
                rel="noopener noreferrer">GitHub</a
            >, or just send me an <a
                href="mailto:sagar.velagala@gmail.com"
                target="_blank"
                rel="noopener noreferrer">email</a
            >.
        </p>
    </main>
</Page>

<style>
    /*
     * The orb sits left of the text and behind it. Its center lines up with the
     * h1 (nudged a little low), its right edge reaches the "g" in "Sagar", and
     * its negative margins keep it from changing the height of the h1 row.
     */
    .hero {
        --h1: clamp(2.75rem, 11vw, 4rem);
        --orb: clamp(7rem, 18vw, 16.5rem); /* resting diameter */
        --overlap: calc(var(--h1) * 1.75); /* reaches the middle of the "g" */

        display: grid;
        grid-template-columns:
            [orb-start] calc(var(--orb) - var(--overlap))
            [text-start] var(--overlap)
            [orb-end] minmax(0, 1fr)
            [text-end];
        max-width: var(--md);
        padding-top: max(1.5rem, calc(var(--orb) / 2 - 3.5rem)); /* clear of the header */
    }

    .pre-title,
    h1,
    .intro {
        grid-column: text-start / text-end;
        position: relative; /* paint above the orb */
    }

    .hero tidal-orb {
        grid-column: orb-start / orb-end;
        grid-row: 2;
        align-self: center;
        width: var(--orb);
        margin-block: calc(var(--orb) / -2);
        translate: 0 6%;
    }

    .pre-title {
        grid-row: 1;
        margin-bottom: -0.5rem;
        padding-left: 0.2rem;
    }

    h1 {
        grid-row: 2;
        margin: 0;
        font-size: var(--h1);
    }

    .intro {
        grid-row: 3;
        margin-top: 0.75rem;
    }

    /* Narrow screens: same offset for the pre-title and h1; the paragraph uses the full width. */
    @media (width < 40rem) {
        .hero {
            --bleed: 0.5rem;
            --overlap: calc(var(--h1) * 1.2);

            grid-template-columns:
                [orb-start body-start] calc(var(--orb) - var(--bleed) - var(--overlap))
                [text-start] var(--overlap)
                [orb-end] minmax(0, 1fr)
                [text-end];
        }

        .hero tidal-orb {
            margin-inline-start: calc(-1 * var(--bleed));
            translate: 0 2%;
        }

        .intro {
            grid-column: body-start / text-end;
        }
    }
</style>
